# Environment Variables Example for FinShield

# App Config
PROJECT_NAME=FinShield
ENV=development
SECRET_KEY=finshield-secret-key-super-secure-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000

# Database (Default is SQLite; swap to PostgreSQL for production)
DATABASE_URL=sqlite:///./finshield.db
# DATABASE_URL=postgresql://user:password@localhost:5432/finshield

# AI Provider Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-3-7-sonnet-20250219
LLM_TEMPERATURE=0.1
CONFIDENCE_THRESHOLD=0.70

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External APIs
OPEN_SANCTIONS_API_KEY=optional-open-sanctions-key
